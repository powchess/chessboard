{
	"name": "@powchess/chessboard",
	"private": false,
	"version": "2.0.0",
	"description": "Chessboard UI Package for PowChess.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/powchess/chessboard.git"
	},
	"bugs": {
		"url": "https://github.com/powchess/chessboard/issues"
	},
	"keywords": [
		"chess",
		"powchess",
		"svelte",
		"chessboard",
		"ui",
		"typescript"
	],
	"author": "PowChess GmbH",
	"license": "MIT",
	"homepage": "https://powchess.com",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"dev": "vite dev --port 4000",
		"dev:host": "vite dev --port 4000 --host",
		"build": "vite build",
		"preview": "vite preview --port 4000",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "svelte-kit sync && eslint . --cache",
		"lint:fix": "eslint . --fix --cache",
		"format": "prettier --ignore-path .gitignore --write .",
		"format:check": "prettier --ignore-path .gitignore --check .",
		"test": "vitest run",
		"package": "svelte-kit sync && svelte-package && publint"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@tailwindcss/postcss": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/prismjs": "^1.26.6",
		"chess.js": "^1.4.0",
		"cooltipz-css": "^2.5.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"jsdom": "^30.0.1",
		"postcss": "^8.5.28",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prism-svelte": "^0.5.0",
		"prismjs": "^1.30.0",
		"publint": "^0.3.24",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./pieces": {
			"types": "./dist/state/piece.d.ts",
			"default": "./dist/state/piece.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.57.0"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"typesVersions": {
		">4.0": {
			"pieces": [
				"./dist/state/piece.d.ts"
			]
		}
	}
}
